DATABASE_URL=postgresql+psycopg://lavish:lavish_local_only@db:5432/lavish
POSTGRES_USER=lavish
POSTGRES_PASSWORD=lavish_local_only
POSTGRES_DB=lavish
DEMO_PASSWORD=DemoDrive!2026
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# For hosted same-origin requests, build the web app with NEXT_PUBLIC_API_URL=/api/v1.
# Set API_INTERNAL_ORIGIN on its server to the backend HTTPS origin (no /api/v1).
API_INTERNAL_ORIGIN=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Filesystem for local development; database keeps uploads durable on serverless.
UPLOAD_STORAGE=filesystem
# Optional concierge extraction. Never put these in NEXT_PUBLIC variables.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
